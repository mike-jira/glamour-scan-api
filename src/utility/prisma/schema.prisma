datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LoginStategy {
  GMAIL
  LOCAL
  FACEBOOK
}

enum Role {
  ADMIN
  SUBADMIN
  PRODUCTOWNER
  PRODUCTOFFICER
  USER
}

model User {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  username     String       @unique
  email        String?      @unique
  password     String?
  googleId     String?      @unique
  facebookId   String?      @unique
  role         Role         @default(USER)
  loginStategy LoginStategy @default(LOCAL)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  useInvited   Invite[]     @relation("UsedBy")
  company      Company[]
  invited      Invite[]     @relation("InvitedBy")
}

enum inviteOnlyRole {
  SUBADMIN
  PRODUCTOWNER
  PRODUCTOFFICER
}

model Invite {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  token           String         @unique
  email           String
  role            inviteOnlyRole
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  expiresAt       DateTime
  used            Boolean        @default(false)
  useAt           DateTime?
  usedBy          User?          @relation("UsedBy", fields: [userId], references: [id])
  userId          String?        @db.ObjectId
  company         Company?       @relation(fields: [companyId], references: [id])
  companyId       String?        @db.ObjectId
  inviteBy        User?          @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  invitedByUserId String?        @db.ObjectId
}

model Company {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  name   String   @unique
  owner  User?    @relation(fields: [userId], references: [id])
  userId String?  @db.ObjectId
  Invite Invite[]
}

model Category {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  products Product[]
}

enum Status {
  ACTIVE
  INACTIVE
}

model Product {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  name        String        @unique
  description String?
  images      String[]
  category    Category?     @relation(fields: [categoryId], references: [id])
  categoryId  String?       @db.ObjectId
  status      Status        @default(ACTIVE)
  qrcode      String?
  lazadaUrl   String
  totalClick  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ScanHistory ScanHistory[]
}

model ScanHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  scans     Int      @default(0)
  date      DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  ipAddress String[]

  @@unique([productId, date])
}
